+extern "C" JNIEXPORT void JNICALL
+Java_com_xstreaming_settings_NativeSettingsStore_nativeSetUserSettingsJson(JNIEnv* env,
+                                                                            jobject /* this */,
+                                                                            jstring json) {
+  if (json == nullptr) {
