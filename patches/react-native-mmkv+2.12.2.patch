@@ -62,6 +62,26 @@ std::string jstringToStdString(JNIEnv* env, jstring jStr) {
   return ret;
 }
 
+// Inverse of jstringToStdString above, needed because JNI's own
+// NewStringUTF only accepts "modified UTF-8" (no real 4-byte sequences,
+// e.g. emoji) -- going through `new String(byte[], "UTF-8")` the same way
+// jstringToStdString goes through `String.getBytes("UTF-8")` handles real
+// UTF-8 input correctly either direction.
+jstring stdStringToJstring(JNIEnv* env, const std::string& str) {
+  const auto byteArray = env->NewByteArray((jsize)str.size());
+  env->SetByteArrayRegion(byteArray, 0, (jsize)str.size(), (const jbyte*)str.data());
+
+  const auto stringClass = env->FindClass("java/lang/String");
+  const auto ctor = env->GetMethodID(stringClass, "<init>", "([BLjava/lang/String;)V");
+  const auto encoding = env->NewStringUTF("UTF-8");
+  const auto result = (jstring)env->NewObject(stringClass, ctor, byteArray, encoding);
+
+  env->DeleteLocalRef(byteArray);
+  env->DeleteLocalRef(encoding);
+  env->DeleteLocalRef(stringClass);
+  return result;
+}
