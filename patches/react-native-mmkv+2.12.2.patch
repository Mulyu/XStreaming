+// --- XStreaming patch: direct native (non-JSI) access to the default MMKV
+// instance's "user.settings" key, for a Kotlin-only settings UI that doesn't
+// go through the JS bridge at all. MMKV::mmkvWithID(...) returns the SAME
+// process-wide singleton instance JS's `new MMKV()` (id "mmkv.default", no
+// explicit path) already uses. Calling this from a SEPARATE MMKV
+// dependency/instance would NOT be safe (two independent copies of MMKV's
+// C++ core racing the same mmap'd file); this works only because it's
+// compiled into this exact same reactnativemmkv.so, sharing MMKV's one
+// static instance registry with the calls above.
+//
+// mmkvRootDirReady() checks MMKV::getRootDir() rather than just assuming
+// nativeInstall above has already run initializeMMKV(): that's normally
+// true well before any native UI reachable only from within the already-
+// running app could call this (shared/lib/mmkv.ts's `new MMKV()` runs at JS
+// module-import time), EXCEPT when Android recreates this Activity directly
+// after the whole process was killed in the background -- then this native
+// Settings UI can become the very first code to run in the new process,
+// with RN/JS never having started at all. nativeEnsureMmkvInitialized
+// below covers that case explicitly, rather than silently falling back to
+// defaultSettings and discarding writes until JS eventually starts.
+bool mmkvRootDirReady() {
+  return !MMKV::getRootDir().empty();
+}
+
+// Mirrors nativeInstall's own MMKV::initializeMMKV call -- same log levels
+// -- but reachable from Kotlin with no JSI runtime/JS bridge involved.
+// Callers pass the exact same default root directory MmkvModule.java's
+// install() computes when JS doesn't override it (getFilesDir() +
+// "/mmkv"), so whichever side -- this or JS's own later `new MMKV()` --
+// happens to initialize MMKV first, the other's later call is a no-op
+// against the identical path: NOT because MMKV::initializeMMKV() itself is
+// a no-op on repeat calls (it unconditionally reassigns MMKV's root-dir
+// state and re-runs mkPath every time it's actually invoked), but because
+// the mmkvRootDirReady() check-then-act below, under the same mutex
+// nativeInstall above now also takes, only ever calls it the first time
+// either path runs in this process.
+extern "C" JNIEXPORT void JNICALL
+Java_com_xstreaming_settings_NativeSettingsStore_nativeEnsureMmkvInitialized(
+    JNIEnv* env, jobject /* this */, jstring rootDirectory) {
+  std::lock_guard<std::mutex> lock(gMmkvInitMutex);
+  if (mmkvRootDirReady()) {
+    return;
+  }
+#if DEBUG
+  MMKVLogLevel logLevel = MMKVLogDebug;
+#else
+  MMKVLogLevel logLevel = MMKVLogError;
+#endif
+  std::string storageDirectory = jstringToStdString(env, rootDirectory);
+  MMKV::initializeMMKV(storageDirectory, logLevel);
+}
+
+extern "C" JNIEXPORT jstring JNICALL
+Java_com_xstreaming_settings_NativeSettingsStore_nativeGetUserSettingsJson(JNIEnv* env,
+                                                                            jobject /* this */) {
+  {
+    // Scoped to just this check: MMKV::getRootDir() (read by
+    // mmkvRootDirReady()) returns a reference into the same unsynchronized
+    // static state initializeMMKV() above writes under gMmkvInitMutex, so
+    // this read needs the same lock -- the rest of MMKV's own API below
+    // (mmkvWithID/getString) is already thread-safe on its own.
+    std::lock_guard<std::mutex> lock(gMmkvInitMutex);
+    if (!mmkvRootDirReady()) {
+      return nullptr;
+    }
+  }
+  MMKV* mmkv = MMKV::mmkvWithID("mmkv.default", mmkv::DEFAULT_MMAP_SIZE, MMKV_SINGLE_PROCESS, nullptr, nullptr);
+  if (mmkv == nullptr) {
+    return nullptr;
+  }
+  std::string result;
+  bool hasValue = mmkv->getString("user.settings", result);
+  if (!hasValue) {
+    return nullptr;
+  }
+  return stdStringToJstring(env, result);
+}
+
+extern "C" JNIEXPORT void JNICALL
+Java_com_xstreaming_settings_NativeSettingsStore_nativeSetUserSettingsJson(JNIEnv* env,
+                                                                            jobject /* this */,
+                                                                            jstring json) {
+  if (json == nullptr) {
+    return;
+  }
+  {
+    // Same reasoning as nativeGetUserSettingsJson's lock above.
+    std::lock_guard<std::mutex> lock(gMmkvInitMutex);
+    if (!mmkvRootDirReady()) {
+      return;
+    }
+  }
+  MMKV* mmkv = MMKV::mmkvWithID("mmkv.default", mmkv::DEFAULT_MMAP_SIZE, MMKV_SINGLE_PROCESS, nullptr, nullptr);
+  if (mmkv == nullptr) {
+    return;
+  }
+  std::string value = jstringToStdString(env, json);
+  mmkv->set(value, "user.settings");
+}
