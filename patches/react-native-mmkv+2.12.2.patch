+// Mirrors nativeInstall's own (now guarded) MMKV::initializeMMKV call --
+// same log levels, same gMmkvInitMutex, same "only the first caller in this
+// process actually runs initializeMMKV" guarantee -- but reachable from
+// Kotlin with no JSI runtime/JS bridge involved. Callers pass the exact
+// same default root directory MmkvModule.java's install() computes when JS
+// doesn't override it (getFilesDir() + "/mmkv"), so whichever of this and
+// nativeInstall gets there first, the other's call is a no-op against the
+// identical path, not a second, divergent store.
+extern "C" JNIEXPORT void JNICALL
+Java_com_xstreaming_settings_NativeSettingsStore_nativeEnsureMmkvInitialized(
+    JNIEnv* env, jobject /* this */, jstring rootDirectory) {
+  std::lock_guard<std::mutex> lock(gMmkvInitMutex);
+  if (mmkvRootDirReady()) {
+    return;
+  }
+#if DEBUG
+  MMKVLogLevel logLevel = MMKVLogDebug;
+#else
+  MMKVLogLevel logLevel = MMKVLogError;
+#endif
+  std::string storageDirectory = jstringToStdString(env, rootDirectory);
+  MMKV::initializeMMKV(storageDirectory, logLevel);
+}
