+// Shared by every nativeClear* function below (including this one) --
+// same reasoning as getMmkvDefaultString/setMmkvDefaultString above: the
+// readiness check is scoped to just that check, since
+// MMKV::mmkvWithID/removeValueForKey are already thread-safe on their own
+// and don't need gMmkvInitMutex held around them too.
+void removeMmkvDefaultKey(const std::string& key) {
+  {
+    std::lock_guard<std::mutex> lock(gMmkvInitMutex);
+    if (!mmkvRootDirReady()) {
+      return;
+    }
+  }
+  MMKV* mmkv = MMKV::mmkvWithID("mmkv.default", mmkv::DEFAULT_MMAP_SIZE, MMKV_SINGLE_PROCESS, nullptr, nullptr);
+  if (mmkv == nullptr) {
+    return;
+  }
+  mmkv->removeValueForKey(key);
+}
