+// Shared by every nativeGet*Json function below: looks up a fixed key on
+// the default MMKV instance, behind the same readiness check
+// nativeGetUserSettingsJson originally had inline. Scoped lock covers just
+// the readiness check -- MMKV::getRootDir() (read by mmkvRootDirReady())
+// returns a reference into the same unsynchronized static state
+// initializeMMKV() above writes under gMmkvInitMutex, so this read needs
+// the same lock; the rest of MMKV's own API below (mmkvWithID/getString)
+// is already thread-safe on its own.
+bool getMmkvDefaultString(const std::string& key, std::string& out) {
+  {
+    std::lock_guard<std::mutex> lock(gMmkvInitMutex);
+    if (!mmkvRootDirReady()) {
+      return false;
+    }
+  }
+  MMKV* mmkv = MMKV::mmkvWithID("mmkv.default", mmkv::DEFAULT_MMAP_SIZE, MMKV_SINGLE_PROCESS, nullptr, nullptr);
+  if (mmkv == nullptr) {
+    return false;
+  }
+  return mmkv->getString(key, out);
+}
+
+// Shared by every nativeSet*Json/nativeSet*Id function below -- same
+// reasoning as getMmkvDefaultString above, for writes.
+bool setMmkvDefaultString(const std::string& key, const std::string& value) {
+  {
+    std::lock_guard<std::mutex> lock(gMmkvInitMutex);
+    if (!mmkvRootDirReady()) {
+      return false;
+    }
+  }
+  MMKV* mmkv = MMKV::mmkvWithID("mmkv.default", mmkv::DEFAULT_MMAP_SIZE, MMKV_SINGLE_PROCESS, nullptr, nullptr);
+  if (mmkv == nullptr) {
+    return false;
+  }
+  mmkv->set(value, key);
+  return true;
+}
